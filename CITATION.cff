version: 0.1.0
license: MIT
repository-code: "https://github.com/randsley/dataeuropa"
url: "https://randsley.github.io/dataeuropa/"
keywords:
  - open data
  - data.europa.eu
  - European data portal
  - DCAT-AP
  - SPARQL
  - geodata
  - Python
